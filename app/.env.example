# Plantaphilia — API Secrets (Vorlage)
# Kopiere diese Datei nach app/.env und trage die echten Werte ein.
# app/.env wird NICHT in Git eingecheckt.

# NVIDIA NIM API Keys (komma-getrennt, kein Leerzeichen)
PLANTAPHILIA_NVAPI_KEYS=nvapi-xxxxx,nvapi-yyyyy

# Modell-ID
PLANTAPHILIA_NVAPI_MODEL=z-ai/glm-5.1

# Endpunkt
PLANTAPHILIA_NVAPI_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
