# ── Secrets ──────────────────────────────────────────────────────
app/.env
*.env
!*.env.example

# ── WordPress-Konfiguration (enthält DB-Credentials) ─────────────
app/public/wp-config.php
app/public/wp-config-sample.php

# ── Uploads (zu groß für Git) ────────────────────────────────────
app/public/wp-content/uploads/*
!app/public/wp-content/uploads/2022/

# ── Debug-Log (kann sensible Daten enthalten) ─────────────────────
app/public/wp-content/debug.log

# ── Caches & Build-Artefakte ─────────────────────────────────────
app/public/wp-content/cache/
*.log
*.tmp
.DS_Store
Thumbs.db

# ── Vollständige DB-Dumps / Seiten-Backups (enthalten Kundendaten,
#    nie committen — siehe History-Bereinigung 2026-08-25) ────────
app/sql/*.sql
app/sql/*.tmp
app/public/wp-content/wpvividbackups/

# ── Desktop-App (Electron) ─────────────────────────────────────────
desktop-app/node_modules/
desktop-app/dist/
desktop-app/dist-electron/
desktop-app/*.db
