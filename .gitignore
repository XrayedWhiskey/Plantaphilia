# ── Secrets ──────────────────────────────────────────────────────
app/.env
*.env
!*.env.example

# ── WordPress-Konfiguration (enthält DB-Credentials) ─────────────
app/public/wp-config.php
app/public/wp-config-sample.php

# ── Uploads (zu groß für Git) ────────────────────────────────────
app/public/wp-content/uploads/*
!app/public/wp-content/uploads/2022/

# ── Debug-Log (kann sensible Daten enthalten) ─────────────────────
app/public/wp-content/debug.log

# ── Caches & Build-Artefakte ─────────────────────────────────────
app/public/wp-content/cache/
*.log
*.tmp
.DS_Store
Thumbs.db
