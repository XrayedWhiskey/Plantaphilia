{
    "name":  "plantaphilia-app",
    "version":  "2.2.4",
    "description":  "Plantaphilia Desktop App",
    "author":  "Plantaphilia",
    "main":  "dist-electron/main/index.js",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build \u0026\u0026 electron-builder --win --x64"
                },
    "dependencies":  {
                         "better-sqlite3":  "^9.4.3",
                         "electron-updater":  "^6.1.8",
                         "sharp":  "^0.33.3"
                     },
    "devDependencies":  {
                            "@vitejs/plugin-react":  "^4.2.1",
                            "autoprefixer":  "^10.4.17",
                            "electron":  "^29.1.1",
                            "electron-builder":  "^24.13.3",
                            "electron-rebuild":  "^3.2.9",
                            "postcss":  "^8.4.35",
                            "react":  "^18.2.0",
                            "react-dom":  "^18.2.0",
                            "tailwindcss":  "^3.4.1",
                            "vite":  "^5.1.4",
                            "vite-plugin-electron":  "^0.28.4",
                            "vite-plugin-electron-renderer":  "^0.14.5"
                        },
    "build":  {
                  "appId":  "eu.plantaphilia.app",
                  "productName":  "Produkte",
                  "directories":  {
                                      "output":  "../",
                                      "buildResources":  "resources"
                                  },
                  "files":  [
                                "dist/**/*",
                                "dist-electron/**/*"
                            ],
                  "asar":  true,
                  "asarUnpack":  [
                                     "node_modules/better-sqlite3/**/*",
                                     "node_modules/sharp/**/*"
                                 ],
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ]
                          },
                  "npmRebuild":  false,
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "language":  "1031"
                           }
              }
}